{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestrator",
  "version": "0.1.0",
  "identifier": "dev.alinion.orchestrator",
  "build": {
    "beforeDevCommand": "npm run build:orch && vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Orchestrator", "width": 1100, "height": 820, "minWidth": 700, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/orch.mjs": "resources/orch.mjs" }
  }
}
