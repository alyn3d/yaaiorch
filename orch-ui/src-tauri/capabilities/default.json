{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "vscode://file/*"
        },
        {
          "url": "cursor://file/*"
        },
        {
          "url": "windsurf://file/*"
        },
        {
          "url": "vscode-insiders://file/*"
        }
      ]
    }
  ]
}
