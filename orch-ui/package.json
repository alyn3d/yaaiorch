{
  "name": "yaaiorch-ui",
  "version": "0.1.0",
  "description": "YAAIORCH (Yet Another AI Orchestrator): browser UI and desktop app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alyn3d/yaaiorch.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server.ts",
    "build:orch": "esbuild ../orch.ts --bundle --platform=node --format=esm --target=node20 --outfile=src-tauri/resources/orch.mjs",
    "build:app": "npm run build:orch && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "sass": "^1.80.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.25.0"
  }
}
